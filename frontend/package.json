{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"generate:rest": "bunx @hey-api/openapi-ts",
		"generate:realtime": "cd ../backend && dotnet tsrts --project GeoBingo.Contracts/GeoBingo.Contracts.csproj --output ../frontend/src/lib/generated/realtime --serializer json --naming-style camelCase --enum name"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@hey-api/openapi-ts": "^0.99.0",
		"@storybook/addon-docs": "^10.5.4",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/sveltekit": "^10.5.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/luxon": "^3.7.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "^10.5.4",
		"svelte": "^5.56.8",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@lucide/svelte": "^1.27.0",
		"@microsoft/signalr": "^10.0.0",
		"luxon": "^3.7.2",
		"valibot": "^1.4.2"
	}
}
