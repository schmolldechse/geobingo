{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Authentication": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Observability": {
    "Otlp": {
      "Enabled": false,
      "Endpoint": ""
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Provider": {
      "Google": {
        "ClientId": "",
        "ClientSecret": "",
        "CallbackPath": "/api/auth/google/callback"
      }
    },
    "Session": {
      "AuthenticationScheme": "GeoBingo.Auth"
    },
    "AllowedOrigins": [
      "https://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=geobingo;Username=geobingo;Password=password"
  }
}
